# Fixture for .github/scripts/smoke-load.cjs. KEY=VALUE, # starts a comment.

# This action fetches its deploy config over the GitHub API before reading any
# field off it (getDeployConfig -> JSON.parse -> deployConfig.artifactKey in
# src/index.ts). Offline the fetch cannot succeed, JSON.parse throws, and the
# action dereferences the undefined config -- a genuine precondition failure
# that strict mode would misread as dependency API drift. No fixture can fix
# that without a network and a token, so this action stays on the default
# always-fatal patterns.
SMOKE_STRICT=0

INPUT_ENVNAME=dev
